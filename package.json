{
  "name": "digitalwork-escrow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "compile": "node scripts/hardhat.cjs compile",
    "test": "node scripts/hardhat.cjs test",
    "start": "node scripts/serve.cjs",
    "test:web": "node --test checks/browser.cjs",
    "start:demo": "node scripts/hardhat.cjs --demo run scripts/serve.cjs",
    "test:wallet": "node --test checks/wallet.cjs",
    "start:local": "node scripts/hardhat.cjs --local run scripts/serve.cjs",
    "check:sepolia-roles": "node scripts/deploy-sepolia.cjs --check-roles",
    "deploy:sepolia": "npm run compile && node scripts/deploy-sepolia.cjs",
    "setup:sepolia": "npm run compile && node scripts/serve.cjs --setup",
    "build:pages": "node scripts/build-pages.cjs",
    "start:v2": "node scripts/serve-v2.cjs",
    "start:demo:v2": "node scripts/hardhat.cjs --v2 --demo run scripts/serve.cjs",
    "start:local:v2": "node scripts/hardhat.cjs --v2 --local run scripts/serve.cjs",
    "setup:sepolia:v2": "npm run compile && node scripts/serve-v2.cjs --setup",
    "test:web:v2": "node --test checks/milestones.cjs",
    "test:pages": "node scripts/hardhat.cjs run checks/pages.cjs"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-ethers": "3.0.8",
    "ethers": "6.15.0",
    "hardhat": "2.26.3",
    "solc": "0.8.30"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
